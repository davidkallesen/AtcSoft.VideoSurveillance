<atc:NiceWindow
    x:Class="AtcSoft.VideoSurveillance.Wpf.Dialogs.CameraEditDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:atcTranslation="https://github.com/atc-net/atc-wpf/tree/main/schemas/translations"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:atc="https://github.com/atc-net/atc-wpf/tree/main/schemas"
    xmlns:atcValueConverters="https://github.com/atc-net/atc-wpf/tree/main/schemas/value-converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:dialogs="clr-namespace:AtcSoft.VideoSurveillance.Wpf.Dialogs"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="{Binding DialogTitle}"
    Width="500"
    SizeToContent="Height"
    WindowStartupLocation="CenterOwner"
    d:DataContext="{d:DesignInstance Type=dialogs:CameraEditDialogViewModel}"
    mc:Ignorable="d">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  Connection Settings  -->
        <GroupBox Grid.Row="0" Header="{atcTranslation:Resx ResxName=AtcSoft.VideoSurveillance.Resources.Translations, Key=Connection}">
            <StackPanel Margin="8">
                <atc:LabelTextBox
                    Margin="0,4"
                    IsMandatory="True"
                    LabelText="{atcTranslation:Resx ResxName=AtcSoft.VideoSurveillance.Resources.Translations, Key=DisplayName}"
                    Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}" />
                <atc:LabelTextBox
                    Margin="0,4"
                    LabelText="{atcTranslation:Resx ResxName=AtcSoft.VideoSurveillance.Resources.Translations, Key=Description}"
                    Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" />
                <atc:LabelTextBox
                    Margin="0,4"
                    IsMandatory="True"
                    LabelText="{atcTranslation:Resx ResxName=AtcSoft.VideoSurveillance.Resources.Translations, Key=IpAddress}"
                    Text="{Binding IpAddress, UpdateSourceTrigger=PropertyChanged}" />
                <atc:LabelIntegerBox
                    Margin="0,4"
                    LabelText="{atcTranslation:Resx ResxName=AtcSoft.VideoSurveillance.Resources.Translations, Key=Port}"
                    Value="{Binding Port, UpdateSourceTrigger=PropertyChanged}" />
                <atc:LabelComboBox
                    Margin="0,4"
                    Items="{Binding ProtocolItems}"
                    LabelText="{atcTranslation:Resx ResxName=AtcSoft.VideoSurveillance.Resources.Translations, Key=Protocol}"
                    SelectedKey="{Binding SelectedProtocolKey, UpdateSourceTrigger=PropertyChanged}" />
                <atc:LabelTextBox
                    Margin="0,4"
                    LabelText="{atcTranslation:Resx ResxName=AtcSoft.VideoSurveillance.Resources.Translations, Key=Path}"
                    Text="{Binding Path, UpdateSourceTrigger=PropertyChanged}" />
                <atc:LabelComboBox
                    Margin="0,4"
                    Items="{Binding ConnectionTypeItems}"
                    LabelText="{atcTranslation:Resx ResxName=AtcSoft.VideoSurveillance.Resources.Translations, Key=ConnectionType}"
                    SelectedKey="{Binding SelectedConnectionTypeKey, UpdateSourceTrigger=PropertyChanged}" />
                <atc:LabelComboBox
                    Margin="0,4"
                    Items="{Binding RotationItems}"
                    LabelText="{atcTranslation:Resx ResxName=AtcSoft.VideoSurveillance.Resources.Translations, Key=RotationClockwise}"
                    SelectedKey="{Binding SelectedRotationKey, UpdateSourceTrigger=PropertyChanged}" />
                <!--  Server-side ONVIF detection (edit mode only; uses the stored credentials)  -->
                <StackPanel
                    Margin="0,4"
                    Orientation="Horizontal"
                    Visibility="{Binding IsConnectionTypeDetectionAvailable, Converter={x:Static atcValueConverters:BoolToVisibilityVisibleValueConverter.Instance}}">
                    <Button
                        Padding="10,2"
                        Command="{Binding DetectConnectionTypeCommand}"
                        Content="{atcTranslation:Resx ResxName=AtcSoft.VideoSurveillance.Resources.Translations, Key=DetectConnectionType}" />
                    <TextBlock
                        Margin="8,0,0,0"
                        VerticalAlignment="Center"
                        Text="{Binding ConnectionTypeDetectionStatus}" />
                </StackPanel>
            </StackPanel>
        </GroupBox>

        <!--  Authentication  -->
        <GroupBox
            Grid.Row="1"
            Margin="0,8,0,0"
            Header="{atcTranslation:Resx ResxName=AtcSoft.VideoSurveillance.Resources.Translations, Key=Authentication}">
            <StackPanel Margin="8">
                <atc:LabelTextBox
                    Margin="0,4"
                    LabelText="{atcTranslation:Resx ResxName=AtcSoft.VideoSurveillance.Resources.Translations, Key=Username}"
                    Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" />
                <atc:LabelPasswordBox
                    Margin="0,4"
                    LabelText="{atcTranslation:Resx ResxName=AtcSoft.VideoSurveillance.Resources.Translations, Key=Password}"
                    Text="{Binding Password, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>
        </GroupBox>

        <!--  Stream Settings  -->
        <GroupBox
            Grid.Row="2"
            Margin="0,8,0,0"
            Header="{atcTranslation:Resx ResxName=AtcSoft.VideoSurveillance.Resources.Translations, Key=StreamSettings}">
            <StackPanel Margin="8">
                <atc:LabelComboBox
                    Margin="0,4"
                    Items="{Binding OverlayPositionItems}"
                    LabelText="{atcTranslation:Resx ResxName=AtcSoft.VideoSurveillance.Resources.Translations, Key=OverlayPosition}"
                    SelectedKey="{Binding SelectedOverlayPositionKey, UpdateSourceTrigger=PropertyChanged}" />
                <atc:LabelComboBox
                    Margin="0,4"
                    Items="{Binding RtspTransportItems}"
                    LabelText="{atcTranslation:Resx ResxName=AtcSoft.VideoSurveillance.Resources.Translations, Key=RtspTransport}"
                    SelectedKey="{Binding SelectedRtspTransportKey, UpdateSourceTrigger=PropertyChanged}" />
                <atc:LabelCheckBox
                    Margin="0,4"
                    IsChecked="{Binding StreamUseLowLatencyMode}"
                    LabelText="{atcTranslation:Resx ResxName=AtcSoft.VideoSurveillance.Resources.Translations, Key=UseLowLatencyMode}" />
                <atc:LabelIntegerBox
                    Margin="0,4"
                    LabelText="{atcTranslation:Resx ResxName=AtcSoft.VideoSurveillance.Resources.Translations, Key=MaxLatencyMs}"
                    Value="{Binding StreamMaxLatencyMs, UpdateSourceTrigger=PropertyChanged}" />
                <atc:LabelIntegerBox
                    Margin="0,4"
                    LabelText="{atcTranslation:Resx ResxName=AtcSoft.VideoSurveillance.Resources.Translations, Key=BufferDurationMs}"
                    Value="{Binding StreamBufferDurationMs, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>
        </GroupBox>

        <!--  Buttons  -->
        <StackPanel
            Grid.Row="3"
            Margin="0,16,0,0"
            HorizontalAlignment="Right"
            Orientation="Horizontal">
            <Button
                MinWidth="80"
                Margin="0,0,8,0"
                Command="{Binding SaveCommand}"
                Content="{atcTranslation:Resx ResxName=AtcSoft.VideoSurveillance.Resources.Translations, Key=Save}"
                IsDefault="True" />
            <Button
                MinWidth="80"
                Command="{Binding CancelCommand}"
                Content="{atcTranslation:Resx ResxName=AtcSoft.VideoSurveillance.Resources.Translations, Key=Cancel}"
                IsCancel="True" />
        </StackPanel>
    </Grid>
</atc:NiceWindow>