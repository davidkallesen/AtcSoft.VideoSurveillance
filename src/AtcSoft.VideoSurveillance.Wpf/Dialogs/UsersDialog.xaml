<atc:NiceWindow
    x:Class="AtcSoft.VideoSurveillance.Wpf.Dialogs.UsersDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:atcTranslation="https://github.com/atc-net/atc-wpf/tree/main/schemas/translations"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:atc="https://github.com/atc-net/atc-wpf/tree/main/schemas"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:dialogs="clr-namespace:AtcSoft.VideoSurveillance.Wpf.Dialogs"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="{atcTranslation:Resx ResxName=AtcSoft.VideoSurveillance.Resources.Translations, Key=Users}"
    Width="820"
    Height="600"
    MinWidth="640"
    MinHeight="480"
    WindowStartupLocation="CenterOwner"
    d:DataContext="{d:DesignInstance Type=dialogs:UsersDialogViewModel}"
    mc:Ignorable="d">

    <atc:NiceWindow.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </atc:NiceWindow.Resources>

    <DockPanel Margin="16">
        <DockPanel Margin="0,12,0,0" DockPanel.Dock="Bottom">
            <Button
                MinWidth="80"
                Command="{Binding CloseCommand}"
                Content="{atcTranslation:Resx ResxName=AtcSoft.VideoSurveillance.Resources.Translations, Key=Close}"
                DockPanel.Dock="Right"
                IsCancel="True" />
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="{Binding Message}" TextWrapping="Wrap" />
                <TextBlock
                    Foreground="IndianRed"
                    Text="{Binding Problem}"
                    TextWrapping="Wrap" />
            </StackPanel>
        </DockPanel>

        <TabControl>
            <!--  Users  -->
            <TabItem Header="{atcTranslation:Resx ResxName=AtcSoft.VideoSurveillance.Resources.Translations, Key=Users}">
                <atc:GridEx Margin="8" Columns="*,16,280">
                    <DataGrid
                        Grid.Column="0"
                        AutoGenerateColumns="False"
                        CanUserAddRows="False"
                        CanUserDeleteRows="False"
                        IsReadOnly="True"
                        ItemsSource="{Binding Users}"
                        SelectedItem="{Binding SelectedUser, Mode=TwoWay}"
                        SelectionMode="Single">
                        <DataGrid.Columns>
                            <DataGridTextColumn
                                Width="*"
                                Binding="{Binding UserName}"
                                Header="{atcTranslation:Resx ResxName=AtcSoft.VideoSurveillance.Resources.Translations, Key=Username}" />
                            <DataGridTextColumn
                                Width="100"
                                Binding="{Binding RoleText}"
                                Header="{atcTranslation:Resx ResxName=AtcSoft.VideoSurveillance.Resources.Translations, Key=Role}" />
                            <DataGridTextColumn
                                Width="140"
                                Binding="{Binding CreatedText}"
                                Header="{atcTranslation:Resx ResxName=AtcSoft.VideoSurveillance.Resources.Translations, Key=Created}" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel Grid.Column="2">
                        <atc:LabelTextBox
                            Margin="0,4"
                            IsEnabled="{Binding IsNewUser}"
                            IsMandatory="True"
                            LabelText="{atcTranslation:Resx ResxName=AtcSoft.VideoSurveillance.Resources.Translations, Key=Username}"
                            Text="{Binding UserName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <atc:LabelComboBox
                            Margin="0,4"
                            Items="{Binding RoleItems}"
                            LabelText="{atcTranslation:Resx ResxName=AtcSoft.VideoSurveillance.Resources.Translations, Key=Role}"
                            SelectedKey="{Binding SelectedRoleKey}" />
                        <atc:LabelPasswordBox
                            Margin="0,4"
                            InformationText="{atcTranslation:Resx ResxName=AtcSoft.VideoSurveillance.Resources.Translations, Key=LeaveEmptyToKeepIt}"
                            LabelText="{atcTranslation:Resx ResxName=AtcSoft.VideoSurveillance.Resources.Translations, Key=Password}"
                            Text="{Binding Password, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <WrapPanel Margin="0,12,0,0">
                            <Button
                                MinWidth="80"
                                Margin="0,0,8,8"
                                Command="{Binding SaveUserCommand}"
                                Content="{atcTranslation:Resx ResxName=AtcSoft.VideoSurveillance.Resources.Translations, Key=Save}" />
                            <Button
                                MinWidth="80"
                                Margin="0,0,8,8"
                                Command="{Binding NewUserCommand}"
                                Content="{atcTranslation:Resx ResxName=AtcSoft.VideoSurveillance.Resources.Translations, Key=AddUser}" />
                            <Button
                                MinWidth="80"
                                Margin="0,0,8,8"
                                Command="{Binding RemoveUserCommand}"
                                Content="{atcTranslation:Resx ResxName=AtcSoft.VideoSurveillance.Resources.Translations, Key=Remove}" />
                        </WrapPanel>
                    </StackPanel>
                </atc:GridEx>
            </TabItem>

            <!--  API keys  -->
            <TabItem Header="{atcTranslation:Resx ResxName=AtcSoft.VideoSurveillance.Resources.Translations, Key=ApiKeys}">
                <atc:GridEx Margin="8" Columns="*,16,280">
                    <DataGrid
                        Grid.Column="0"
                        AutoGenerateColumns="False"
                        CanUserAddRows="False"
                        CanUserDeleteRows="False"
                        IsReadOnly="True"
                        ItemsSource="{Binding ApiKeys}"
                        SelectedItem="{Binding SelectedApiKey, Mode=TwoWay}"
                        SelectionMode="Single">
                        <DataGrid.Columns>
                            <DataGridTextColumn
                                Width="*"
                                Binding="{Binding Name}"
                                Header="{atcTranslation:Resx ResxName=AtcSoft.VideoSurveillance.Resources.Translations, Key=Name}" />
                            <DataGridTextColumn
                                Width="100"
                                Binding="{Binding RoleText}"
                                Header="{atcTranslation:Resx ResxName=AtcSoft.VideoSurveillance.Resources.Translations, Key=Role}" />
                            <DataGridTextColumn
                                Width="140"
                                Binding="{Binding CreatedText}"
                                Header="{atcTranslation:Resx ResxName=AtcSoft.VideoSurveillance.Resources.Translations, Key=Created}" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel Grid.Column="2">
                        <atc:LabelTextBox
                            Margin="0,4"
                            IsMandatory="True"
                            LabelText="{atcTranslation:Resx ResxName=AtcSoft.VideoSurveillance.Resources.Translations, Key=Name}"
                            Text="{Binding ApiKeyName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <atc:LabelComboBox
                            Margin="0,4"
                            Items="{Binding RoleItems}"
                            LabelText="{atcTranslation:Resx ResxName=AtcSoft.VideoSurveillance.Resources.Translations, Key=Role}"
                            SelectedKey="{Binding SelectedApiKeyRoleKey}" />
                        <WrapPanel Margin="0,12,0,0">
                            <Button
                                MinWidth="80"
                                Margin="0,0,8,8"
                                Command="{Binding CreateApiKeyCommand}"
                                Content="{atcTranslation:Resx ResxName=AtcSoft.VideoSurveillance.Resources.Translations, Key=AddApiKey}" />
                            <Button
                                MinWidth="80"
                                Margin="0,0,8,8"
                                Command="{Binding RemoveApiKeyCommand}"
                                Content="{atcTranslation:Resx ResxName=AtcSoft.VideoSurveillance.Resources.Translations, Key=Remove}" />
                        </WrapPanel>

                        <StackPanel Margin="0,12,0,0" Visibility="{Binding HasMadeApiKey, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock
                                Margin="0,0,0,4"
                                Text="{atcTranslation:Resx ResxName=AtcSoft.VideoSurveillance.Resources.Translations, Key=ApiKeyShownOnce}"
                                TextWrapping="Wrap" />
                            <TextBox
                                AutomationProperties.Name="{atcTranslation:Resx ResxName=AtcSoft.VideoSurveillance.Resources.Translations, Key=ApiKey}"
                                IsReadOnly="True"
                                Text="{Binding MadeApiKey, Mode=OneWay}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </StackPanel>
                </atc:GridEx>
            </TabItem>

            <!--  Audit log  -->
            <TabItem Header="{atcTranslation:Resx ResxName=AtcSoft.VideoSurveillance.Resources.Translations, Key=AuditLog}">
                <DataGrid
                    Margin="8"
                    AutoGenerateColumns="False"
                    CanUserAddRows="False"
                    CanUserDeleteRows="False"
                    IsReadOnly="True"
                    ItemsSource="{Binding AuditEntries}"
                    SelectionMode="Single">
                    <DataGrid.Columns>
                        <DataGridTextColumn
                            Width="150"
                            Binding="{Binding TimeText}"
                            Header="{atcTranslation:Resx ResxName=AtcSoft.VideoSurveillance.Resources.Translations, Key=Time}" />
                        <DataGridTextColumn
                            Width="120"
                            Binding="{Binding UserName}"
                            Header="{atcTranslation:Resx ResxName=AtcSoft.VideoSurveillance.Resources.Translations, Key=AuditUser}" />
                        <DataGridTextColumn
                            Width="160"
                            Binding="{Binding Action}"
                            Header="{atcTranslation:Resx ResxName=AtcSoft.VideoSurveillance.Resources.Translations, Key=AuditAction}" />
                        <DataGridTextColumn
                            Width="*"
                            Binding="{Binding Target}"
                            Header="{atcTranslation:Resx ResxName=AtcSoft.VideoSurveillance.Resources.Translations, Key=AuditTarget}" />
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
        </TabControl>
    </DockPanel>
</atc:NiceWindow>