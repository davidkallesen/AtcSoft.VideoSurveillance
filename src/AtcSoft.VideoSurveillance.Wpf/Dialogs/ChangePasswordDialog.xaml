<atc:NiceWindow
    x:Class="AtcSoft.VideoSurveillance.Wpf.Dialogs.ChangePasswordDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:atcTranslation="https://github.com/atc-net/atc-wpf/tree/main/schemas/translations"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:atc="https://github.com/atc-net/atc-wpf/tree/main/schemas"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:dialogs="clr-namespace:AtcSoft.VideoSurveillance.Wpf.Dialogs"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="{atcTranslation:Resx ResxName=AtcSoft.VideoSurveillance.Resources.Translations, Key=ChangePassword}"
    Width="420"
    ResizeMode="NoResize"
    SizeToContent="Height"
    WindowStartupLocation="CenterOwner"
    d:DataContext="{d:DesignInstance Type=dialogs:ChangePasswordDialogViewModel}"
    mc:Ignorable="d">

    <StackPanel Margin="16">
        <atc:LabelPasswordBox
            Margin="0,4"
            IsMandatory="True"
            LabelText="{atcTranslation:Resx ResxName=AtcSoft.VideoSurveillance.Resources.Translations, Key=CurrentPassword}"
            Text="{Binding CurrentPassword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
        <atc:LabelPasswordBox
            Margin="0,4"
            InformationText="{atcTranslation:Resx ResxName=AtcSoft.VideoSurveillance.Resources.Translations, Key=PasswordTooShort}"
            IsMandatory="True"
            LabelText="{atcTranslation:Resx ResxName=AtcSoft.VideoSurveillance.Resources.Translations, Key=NewPassword}"
            Text="{Binding NewPassword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
        <TextBlock
            Margin="0,8,0,0"
            Foreground="IndianRed"
            Text="{Binding Problem}"
            TextWrapping="Wrap" />

        <StackPanel
            Margin="0,16,0,0"
            HorizontalAlignment="Right"
            Orientation="Horizontal">
            <Button
                MinWidth="80"
                Margin="0,0,8,0"
                Command="{Binding SaveCommand}"
                Content="{atcTranslation:Resx ResxName=AtcSoft.VideoSurveillance.Resources.Translations, Key=Save}"
                IsDefault="True" />
            <Button
                MinWidth="80"
                Command="{Binding CancelCommand}"
                Content="{atcTranslation:Resx ResxName=AtcSoft.VideoSurveillance.Resources.Translations, Key=Cancel}"
                IsCancel="True" />
        </StackPanel>
    </StackPanel>
</atc:NiceWindow>