<UserControl
    x:Class="AtcSoft.VideoSurveillance.Wpf.Views.TimelineView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:atc="https://github.com/atc-net/atc-wpf/tree/main/schemas"
    xmlns:atcTranslation="https://github.com/atc-net/atc-wpf/tree/main/schemas/translations"
    xmlns:coreControls="clr-namespace:AtcSoft.VideoSurveillance.Wpf.Core.UserControls;assembly=AtcSoft.VideoSurveillance.Wpf.Core"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewModels="clr-namespace:AtcSoft.VideoSurveillance.Wpf.ViewModels"
    d:DataContext="{d:DesignInstance Type=viewModels:TimelineViewModel}"
    Loaded="OnLoaded"
    Unloaded="OnUnloaded"
    mc:Ignorable="d">

    <Grid Margin="16">
        <atc:GridEx Rows="Auto,Auto,*,Auto">

            <!--  What the lanes show  -->
            <TextBlock
                Grid.Row="0"
                Margin="0,0,0,12"
                Opacity="0.75"
                Text="{atcTranslation:Resx ResxName=AtcSoft.VideoSurveillance.Resources.Translations, Key=TimelineHelp}"
                TextWrapping="Wrap" />

            <!--  Span and jumps  -->
            <StackPanel
                Grid.Row="1"
                Margin="0,0,0,12"
                Orientation="Horizontal">
                <Button
                    Margin="0,0,8,0"
                    Padding="16,6"
                    Command="{Binding Path=ShowLast24HoursCommand}"
                    Content="{atcTranslation:Resx ResxName=AtcSoft.VideoSurveillance.Resources.Translations, Key=Last24Hours}" />
                <TextBlock
                    Margin="8,0,8,0"
                    VerticalAlignment="Center"
                    Text="{atcTranslation:Resx ResxName=AtcSoft.VideoSurveillance.Resources.Translations, Key=Day}" />
                <DatePicker
                    Width="140"
                    Margin="0,0,16,0"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="{atcTranslation:Resx ResxName=AtcSoft.VideoSurveillance.Resources.Translations, Key=Day}"
                    SelectedDate="{Binding Path=SelectedDay, Mode=TwoWay}" />
                <Button
                    Margin="0,0,8,0"
                    Padding="16,6"
                    Command="{Binding Path=PreviousEventCommand}"
                    Content="{atcTranslation:Resx ResxName=AtcSoft.VideoSurveillance.Resources.Translations, Key=PreviousEvent}" />
                <Button
                    Margin="0,0,16,0"
                    Padding="16,6"
                    Command="{Binding Path=NextEventCommand}"
                    Content="{atcTranslation:Resx ResxName=AtcSoft.VideoSurveillance.Resources.Translations, Key=NextEvent}" />
                <Button
                    Margin="0,0,16,0"
                    Padding="16,6"
                    Command="{Binding Path=PlayAllCommand}"
                    Content="{atcTranslation:Resx ResxName=AtcSoft.VideoSurveillance.Resources.Translations, Key=PlayAllFromHere}" />
                <Button
                    Margin="0,0,8,0"
                    Padding="12,6"
                    Command="{Binding Path=EarlierCommand}"
                    Content="{atcTranslation:Resx ResxName=AtcSoft.VideoSurveillance.Resources.Translations, Key=Earlier}" />
                <Button
                    Margin="0,0,8,0"
                    Padding="12,6"
                    Command="{Binding Path=ZoomOutCommand}"
                    Content="{atcTranslation:Resx ResxName=AtcSoft.VideoSurveillance.Resources.Translations, Key=ZoomOut}" />
                <Button
                    Margin="0,0,8,0"
                    Padding="12,6"
                    Command="{Binding Path=ZoomInCommand}"
                    Content="{atcTranslation:Resx ResxName=AtcSoft.VideoSurveillance.Resources.Translations, Key=ZoomIn}" />
                <Button
                    Margin="0,0,16,0"
                    Padding="12,6"
                    Command="{Binding Path=LaterCommand}"
                    Content="{atcTranslation:Resx ResxName=AtcSoft.VideoSurveillance.Resources.Translations, Key=Later}" />
                <Button
                    Padding="16,6"
                    Command="{Binding Path=LoadCommand}"
                    Content="{atcTranslation:Resx ResxName=AtcSoft.VideoSurveillance.Resources.Translations, Key=Refresh}" />
            </StackPanel>

            <!--  One lane per camera  -->
            <ScrollViewer
                Grid.Row="2"
                HorizontalScrollBarVisibility="Disabled"
                VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <ItemsControl ItemsSource="{Binding Path=Lanes}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type viewModels:TimelineLaneViewModel}">
                                <atc:GridEx Margin="0,0,0,4" Columns="160,*">
                                    <TextBlock
                                        Grid.Column="0"
                                        VerticalAlignment="Center"
                                        Text="{Binding Path=CameraName}"
                                        TextTrimming="CharacterEllipsis" />
                                    <coreControls:CameraTimelineLane
                                        Grid.Column="1"
                                        Height="36"
                                        AutomationProperties.Name="{Binding Path=CameraName}"
                                        EventBands="{Binding Path=EventBands}"
                                        GapBands="{Binding Path=GapBands}"
                                        NowFraction="{Binding Path=NowFraction}"
                                        SeekCommand="{Binding Path=PlayAtCommand}"
                                        Stretches="{Binding Path=Stretches}"
                                        ToolTip="{atcTranslation:Resx ResxName=AtcSoft.VideoSurveillance.Resources.Translations, Key=TimelineHelp}" />
                                </atc:GridEx>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <atc:GridEx Columns="160,*">
                        <coreControls:TimelineMarksBar
                            Grid.Column="1"
                            Marks="{Binding Path=Marks}"
                            Opacity="0.75" />
                    </atc:GridEx>

                    <!--  Why a lane has a gap  -->
                    <atc:GridEx Margin="0,8,0,0" Columns="160,*">
                        <WrapPanel Grid.Column="1">
                            <StackPanel Margin="0,0,16,0" Orientation="Horizontal">
                                <Rectangle
                                    Width="14"
                                    Height="14"
                                    Margin="0,0,4,0"
                                    Fill="{x:Static coreControls:TimelineGapLook.OfflineBrush}" />
                                <TextBlock VerticalAlignment="Center" Text="{atcTranslation:Resx ResxName=AtcSoft.VideoSurveillance.Resources.Translations, Key=GapOffline}" />
                            </StackPanel>
                            <StackPanel Margin="0,0,16,0" Orientation="Horizontal">
                                <Rectangle
                                    Width="14"
                                    Height="14"
                                    Margin="0,0,4,0"
                                    Fill="{x:Static coreControls:TimelineGapLook.DiskFullBrush}" />
                                <TextBlock VerticalAlignment="Center" Text="{atcTranslation:Resx ResxName=AtcSoft.VideoSurveillance.Resources.Translations, Key=GapDiskFull}" />
                            </StackPanel>
                            <StackPanel Margin="0,0,16,0" Orientation="Horizontal">
                                <Rectangle
                                    Width="14"
                                    Height="14"
                                    Margin="0,0,4,0"
                                    Fill="{x:Static coreControls:TimelineGapLook.ServerDownBrush}" />
                                <TextBlock VerticalAlignment="Center" Text="{atcTranslation:Resx ResxName=AtcSoft.VideoSurveillance.Resources.Translations, Key=GapServerDown}" />
                            </StackPanel>
                            <StackPanel Margin="0,0,16,0" Orientation="Horizontal">
                                <Rectangle
                                    Width="14"
                                    Height="14"
                                    Margin="0,0,4,0"
                                    Fill="{x:Static coreControls:TimelineGapLook.NotRecordingBrush}" />
                                <TextBlock VerticalAlignment="Center" Text="{atcTranslation:Resx ResxName=AtcSoft.VideoSurveillance.Resources.Translations, Key=GapNotRecording}" />
                            </StackPanel>
                            <StackPanel Margin="0,0,16,0" Orientation="Horizontal">
                                <Rectangle
                                    Width="14"
                                    Height="14"
                                    Margin="0,0,4,0"
                                    Fill="{x:Static coreControls:TimelineGapLook.UnknownBrush}" />
                                <TextBlock VerticalAlignment="Center" Text="{atcTranslation:Resx ResxName=AtcSoft.VideoSurveillance.Resources.Translations, Key=GapUnknown}" />
                            </StackPanel>
                        </WrapPanel>
                    </atc:GridEx>
                </StackPanel>
            </ScrollViewer>

            <!--  Status  -->
            <TextBlock
                Grid.Row="3"
                Margin="0,8,0,0"
                Text="{Binding Path=StatusMessage}" />
        </atc:GridEx>
    </Grid>
</UserControl>