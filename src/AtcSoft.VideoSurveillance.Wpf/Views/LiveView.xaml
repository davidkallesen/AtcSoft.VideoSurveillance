<UserControl
    x:Class="AtcSoft.VideoSurveillance.Wpf.Views.LiveView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:atcTranslation="https://github.com/atc-net/atc-wpf/tree/main/schemas/translations"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:atcValueConverters="https://github.com/atc-net/atc-wpf/tree/main/schemas/value-converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:fontIcons="clr-namespace:Atc.Wpf.FontIcons;assembly=Atc.Wpf.FontIcons"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:userControls="clr-namespace:AtcSoft.VideoSurveillance.Wpf.UserControls"
    xmlns:viewModels="clr-namespace:AtcSoft.VideoSurveillance.Wpf.ViewModels"
    d:DataContext="{d:DesignInstance Type=viewModels:LiveViewViewModel}"
    Loaded="OnLoaded"
    Unloaded="OnUnloaded"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  Which cameras are shown: a filter, the grid's size and its pages  -->
        <ToolBar Grid.Row="0">
            <TextBlock
                Margin="4,0,6,0"
                VerticalAlignment="Center"
                Text="{atcTranslation:Resx ResxName=AtcSoft.VideoSurveillance.Resources.Translations, Key=Filter}" />
            <TextBox
                Width="200"
                VerticalAlignment="Center"
                AutomationProperties.Name="Filter cameras"
                Text="{Binding Path=FilterText, UpdateSourceTrigger=PropertyChanged}"
                ToolTip="{atcTranslation:Resx ResxName=AtcSoft.VideoSurveillance.Resources.Translations, Key=FilterCamerasByNameToolTip}" />
            <Button
                AutomationProperties.Name="Clear the filter"
                Command="{Binding ClearFilterCommand}"
                ToolTip="{atcTranslation:Resx ResxName=AtcSoft.VideoSurveillance.Resources.Translations, Key=ClearFilter}">
                <fontIcons:ImageAwesomeSolid
                    Width="12"
                    Height="12"
                    Foreground="{DynamicResource AtcApps.Brushes.ThemeForeground}"
                    Icon="Times" />
            </Button>
            <Separator />
            <TextBlock
                Margin="4,0,6,0"
                VerticalAlignment="Center"
                Text="{atcTranslation:Resx ResxName=AtcSoft.VideoSurveillance.Resources.Translations, Key=GridSizeGroup}" />
            <ComboBox
                Width="190"
                VerticalAlignment="Center"
                AutomationProperties.Name="Grid size"
                DisplayMemberPath="Value"
                ItemsSource="{Binding Path=GridPresetItems}"
                SelectedValue="{Binding Path=SelectedGridPreset}"
                SelectedValuePath="Key"
                ToolTip="{atcTranslation:Resx ResxName=AtcSoft.VideoSurveillance.Resources.Translations, Key=GridSizeToolTip}" />
            <Button
                AutomationProperties.Name="Previous page"
                Command="{Binding PreviousPageCommand}"
                ToolTip="{atcTranslation:Resx ResxName=AtcSoft.VideoSurveillance.Resources.Translations, Key=PreviousPage}">
                <fontIcons:ImageAwesomeSolid
                    Width="12"
                    Height="12"
                    Foreground="{DynamicResource AtcApps.Brushes.ThemeForeground}"
                    Icon="ChevronLeft" />
            </Button>
            <TextBlock
                MinWidth="36"
                VerticalAlignment="Center"
                Text="{Binding Path=PageLabel}"
                TextAlignment="Center" />
            <Button
                AutomationProperties.Name="Next page"
                Command="{Binding NextPageCommand}"
                ToolTip="{atcTranslation:Resx ResxName=AtcSoft.VideoSurveillance.Resources.Translations, Key=NextPage}">
                <fontIcons:ImageAwesomeSolid
                    Width="12"
                    Height="12"
                    Foreground="{DynamicResource AtcApps.Brushes.ThemeForeground}"
                    Icon="ChevronRight" />
            </Button>
        </ToolBar>

        <!--  Camera grid using ItemsControl with UniformGrid panel  -->
        <ItemsControl Grid.Row="1" ItemsSource="{Binding CameraTiles}">
            <ItemsControl.ItemContainerStyle>
                <Style TargetType="ContentPresenter">
                    <Setter Property="Visibility" Value="{Binding Path=IsShownInGrid, Converter={x:Static atcValueConverters:BoolToVisibilityVisibleValueConverter.Instance}}" />
                </Style>
            </ItemsControl.ItemContainerStyle>
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid
                        Columns="{Binding DataContext.GridColumns, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                        Rows="{Binding DataContext.GridRows, RelativeSource={RelativeSource AncestorType=ItemsControl}}" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <userControls:CameraTileBadge Margin="1" />
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!--  Nothing matches the filter  -->
        <TextBlock
            Grid.Row="1"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            FontSize="16"
            Foreground="{DynamicResource AtcApps.Brushes.Gray5}"
            Text="{atcTranslation:Resx ResxName=AtcSoft.VideoSurveillance.Resources.Translations, Key=NoCameraMatchesFilter}"
            Visibility="{Binding Path=HasNoMatches, Converter={x:Static atcValueConverters:BoolToVisibilityVisibleValueConverter.Instance}}" />

        <!--  Loading overlay  -->
        <Border Grid.Row="1" Background="#80000000">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsLoading}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <TextBlock
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                FontSize="16"
                Foreground="{DynamicResource AtcApps.Brushes.ThemeForeground}"
                Text="{atcTranslation:Resx ResxName=AtcSoft.VideoSurveillance.Resources.Translations, Key=LoadingCameras}" />
        </Border>
    </Grid>
</UserControl>