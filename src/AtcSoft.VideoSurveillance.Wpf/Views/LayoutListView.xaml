<UserControl
    x:Class="AtcSoft.VideoSurveillance.Wpf.Views.LayoutListView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:atcTranslation="https://github.com/atc-net/atc-wpf/tree/main/schemas/translations"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:fontIcons="clr-namespace:Atc.Wpf.FontIcons;assembly=Atc.Wpf.FontIcons"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewModels="clr-namespace:AtcSoft.VideoSurveillance.Wpf.ViewModels"
    d:DataContext="{d:DesignInstance Type=viewModels:LayoutListViewModel}"
    Loaded="OnLoaded"
    mc:Ignorable="d">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </UserControl.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  Title  -->
        <TextBlock
            Grid.Row="0"
            Margin="0,0,0,16"
            FontSize="24"
            FontWeight="SemiBold"
            Text="{atcTranslation:Resx ResxName=AtcSoft.VideoSurveillance.Resources.Translations, Key=Layouts}" />

        <!--  Toolbar  -->
        <ToolBar Grid.Row="1" Margin="0,0,0,8">
            <Button AutomationProperties.Name="Add Layout" Command="{Binding AddLayoutCommand}" ToolTip="{atcTranslation:Resx ResxName=AtcSoft.VideoSurveillance.Resources.Translations, Key=AddLayout}">
                <StackPanel Orientation="Horizontal">
                    <fontIcons:ImageAwesomeSolid
                        Width="16"
                        Height="16"
                        Foreground="{DynamicResource AtcApps.Brushes.ThemeForeground}"
                        Icon="Plus" />
                    <TextBlock Margin="6,0,0,0" Text="{atcTranslation:Resx ResxName=AtcSoft.VideoSurveillance.Resources.Translations, Key=AddLayout}" />
                </StackPanel>
            </Button>
            <Separator />
            <Button AutomationProperties.Name="Refresh" Command="{Binding LoadCommand}" ToolTip="{atcTranslation:Resx ResxName=AtcSoft.VideoSurveillance.Resources.Translations, Key=Refresh}">
                <StackPanel Orientation="Horizontal">
                    <fontIcons:ImageAwesomeSolid
                        Width="16"
                        Height="16"
                        Foreground="{DynamicResource AtcApps.Brushes.ThemeForeground}"
                        Icon="SyncAlt" />
                    <TextBlock Margin="6,0,0,0" Text="{atcTranslation:Resx ResxName=AtcSoft.VideoSurveillance.Resources.Translations, Key=Refresh}" />
                </StackPanel>
            </Button>
        </ToolBar>

        <!--  Layout DataGrid  -->
        <DataGrid
            Grid.Row="2"
            AutoGenerateColumns="False"
            CanUserAddRows="False"
            CanUserDeleteRows="False"
            IsReadOnly="True"
            ItemsSource="{Binding Layouts}"
            SelectionMode="Single">
            <DataGrid.Columns>
                <DataGridTextColumn
                    Width="*"
                    Binding="{Binding Name}"
                    Header="{atcTranslation:Resx ResxName=AtcSoft.VideoSurveillance.Resources.Translations, Key=Name}" />
                <DataGridTextColumn
                    Width="100"
                    Binding="{Binding GridDescription}"
                    Header="{atcTranslation:Resx ResxName=AtcSoft.VideoSurveillance.Resources.Translations, Key=GridSizeHeader}" />
                <DataGridTextColumn
                    Width="120"
                    Binding="{Binding CameraCount}"
                    Header="{atcTranslation:Resx ResxName=AtcSoft.VideoSurveillance.Resources.Translations, Key=CameraCount}" />

                <!--  Action buttons  -->
                <DataGridTemplateColumn Width="140" Header="{atcTranslation:Resx ResxName=AtcSoft.VideoSurveillance.Resources.Translations, Key=Actions}">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Button
                                    AutomationProperties.Name="Edit"
                                    Margin="2"
                                    Padding="4,2"
                                    Command="{Binding DataContext.EditLayoutCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                    CommandParameter="{Binding}"
                                    ToolTip="{atcTranslation:Resx ResxName=AtcSoft.VideoSurveillance.Resources.Translations, Key=Edit}">
                                    <fontIcons:ImageAwesomeSolid
                                        Width="14"
                                        Height="14"
                                        Foreground="{DynamicResource AtcApps.Brushes.ThemeForeground}"
                                        Icon="Edit" />
                                </Button>
                                <Button
                                    AutomationProperties.Name="Apply"
                                    Margin="2"
                                    Padding="4,2"
                                    Command="{Binding DataContext.ApplyLayoutCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                    CommandParameter="{Binding}"
                                    ToolTip="{atcTranslation:Resx ResxName=AtcSoft.VideoSurveillance.Resources.Translations, Key=Apply}">
                                    <fontIcons:ImageAwesomeSolid
                                        Width="14"
                                        Height="14"
                                        Foreground="{DynamicResource AtcApps.Brushes.ThemeForeground}"
                                        Icon="Check" />
                                </Button>
                                <Button
                                    AutomationProperties.Name="Delete"
                                    Margin="2"
                                    Padding="4,2"
                                    Command="{Binding DataContext.DeleteLayoutCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                    CommandParameter="{Binding}"
                                    ToolTip="{atcTranslation:Resx ResxName=AtcSoft.VideoSurveillance.Resources.Translations, Key=DeleteRecording}">
                                    <fontIcons:ImageAwesomeSolid
                                        Width="14"
                                        Height="14"
                                        Foreground="OrangeRed"
                                        Icon="TrashAlt" />
                                </Button>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <!--  Loading overlay  -->
        <Border
            Grid.Row="2"
            Background="#80000000"
            Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}">
            <TextBlock
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                FontSize="16"
                Foreground="{DynamicResource AtcApps.Brushes.ThemeForeground}"
                Text="{atcTranslation:Resx ResxName=AtcSoft.VideoSurveillance.Resources.Translations, Key=LoadingLayouts}" />
        </Border>
    </Grid>
</UserControl>