@* A switch with an optional help text behind an info icon, as in the desktop apps' settings dialog. *@
<div class="d-flex align-center @Class">
    <MudSwitch T="bool"
               Value="@Value"
               ValueChanged="@ValueChanged"
               Color="Color.Primary"
               Disabled="@Disabled"
               Label="@Label" />
    @if (!string.IsNullOrEmpty(Help))
    {
        <MudTooltip Placement="Placement.Right" Arrow="true">
            <ChildContent>
                <MudIcon Icon="@Icons.Material.Outlined.Info" Size="Size.Small" Color="Color.Info" Class="ml-1" />
            </ChildContent>
            <TooltipContent>
                <div style="white-space: pre-line; text-align: left; max-width: 480px; @(Monospace ? "font-family: Consolas, 'Courier New', monospace;" : string.Empty)">@Help</div>
            </TooltipContent>
        </MudTooltip>
    }
</div>

@code {
    [Parameter]
    public bool Value { get; set; }

    [Parameter]
    public EventCallback<bool> ValueChanged { get; set; }

    [Parameter, EditorRequired]
    public string Label { get; set; } = string.Empty;

    /// <summary>
    /// Shown when the info icon is hovered. Line breaks are kept.
    /// </summary>
    [Parameter]
    public string? Help { get; set; }

    /// <summary>
    /// Shows the help in a fixed-width font, for paths.
    /// </summary>
    [Parameter]
    public bool Monospace { get; set; }

    [Parameter]
    public bool Disabled { get; set; }

    [Parameter]
    public string? Class { get; set; }
}
