@using MudBlazor
@inject IJSRuntime JS

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">
            <MudIcon Icon="@Icons.Material.Filled.PlayCircle" Class="mr-2" />
            @Title
        </MudText>
    </TitleContent>
    <DialogContent>
        @if (!PlaysInBrowser && !failed)
        {
            <MudAlert Severity="Severity.Info" Dense="true" Class="mb-2">
                Browsers often cannot play this format, and do not turn a rotated picture upright. If it does not play, download it and open it in a video player.
                Recording as MP4 (Settings, Capture) avoids both.
            </MudAlert>
        }

        @if (failed)
        {
            <MudAlert Severity="Severity.Warning" Class="mb-2">
                This browser cannot play the recording. Download it and open it in a video player such as VLC.
            </MudAlert>
        }
        else
        {
            <video controls
                   autoplay
                   style="width: 100%; max-height: 70vh; background: #000;"
                   src="@VideoUrl"
                   @onerror="OnVideoError"></video>
        }
    </DialogContent>
    <DialogActions>
        <MudText Typo="Typo.caption" Class="ml-4 mud-text-secondary" Style="overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">@FileName</MudText>
        <MudSpacer />
        <MudButton StartIcon="@Icons.Material.Filled.Download" OnClick="DownloadAsync">Download</MudButton>
        <MudButton OnClick="Close">Close</MudButton>
    </DialogActions>
</MudDialog>

@code {
    private bool failed;

    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = null!;

    [Parameter]
    public string VideoUrl { get; set; } = string.Empty;

    /// <summary>
    /// The address that makes the browser save the file instead of showing it.
    /// </summary>
    [Parameter]
    public string DownloadUrl { get; set; } = string.Empty;

    [Parameter]
    public string Title { get; set; } = "Recording Playback";

    [Parameter]
    public string FileName { get; set; } = string.Empty;

    /// <summary>
    /// False for a format a browser is not sure to play (MKV, AVI).
    /// </summary>
    [Parameter]
    public bool PlaysInBrowser { get; set; } = true;

    private void OnVideoError()
        => failed = true;

    private async Task DownloadAsync()
        => await JS.InvokeVoidAsync("fileInterop.downloadFromUrl", DownloadUrl, FileName);

    private void Close() => MudDialog.Cancel();
}
