@using MudBlazor

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">@(IsNew ? "Add receiver" : "Edit receiver")</MudText>
    </TitleContent>
    <DialogContent>
        <MudStack Spacing="3" Style="min-width: min(480px, 80vw);">
            <MudTextField @bind-Value="url"
                          Label="Address"
                          Placeholder="https://example.com/hooks/surveillance"
                          HelperText="The server posts each event to this http or https address."
                          Immediate="true"
                          Error="@(showErrors && !WebhookEventChoices.IsUsableAddress(url))"
                          ErrorText="Enter an http or https address."
                          Variant="Variant.Outlined"
                          autocomplete="off" />

            <MudTextField @bind-Value="secret"
                          Label="Secret"
                          InputType="InputType.Password"
                          HelperText="@SecretHint"
                          Variant="Variant.Outlined"
                          autocomplete="new-password" />

            @if (!IsNew && HasSecret)
            {
                <MudCheckBox @bind-Value="removeSecret"
                             Label="Remove the secret (send unsigned requests)"
                             Dense="true" />
            }

            <div>
                <MudText Typo="Typo.subtitle2">Events</MudText>
                <MudText Typo="Typo.caption" Class="mud-text-secondary">
                    Tick what the receiver should get. None ticked means everything.
                </MudText>
                @foreach (var group in WebhookEventChoices.Groups)
                {
                    <MudCheckBox T="bool"
                                 Value="@ticked.Contains(group.Pattern)"
                                 ValueChanged="@(value => Tick(group.Pattern, value))"
                                 Label="@group.Label"
                                 Dense="true" />
                }

                @if (kept.Count > 0)
                {
                    <MudText Typo="Typo.caption" Class="mud-text-secondary">
                        Also set, and kept as they are: @string.Join(", ", kept)
                    </MudText>
                }
            </div>
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Submit">@(IsNew ? "Add" : "Save")</MudButton>
    </DialogActions>
</MudDialog>

@code {
    private readonly HashSet<string> ticked = new(StringComparer.OrdinalIgnoreCase);
    private IReadOnlyList<string> kept = [];
    private string url = string.Empty;
    private string secret = string.Empty;
    private bool removeSecret;
    private bool showErrors;

    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = null!;

    /// <summary>
    /// The receiver to edit; none for a new one.
    /// </summary>
    [Parameter]
    public Webhook? Webhook { get; set; }

    private bool IsNew => Webhook is null;

    private bool HasSecret => Webhook?.HasSecret == true;

    private string SecretHint
    {
        get
        {
            if (IsNew)
            {
                return "Optional. With a secret, every request is signed so the receiver can check it comes from this server.";
            }

            return HasSecret
                ? "A secret is set. Leave empty to keep it, or type a new one to replace it."
                : "No secret is set. Type one to have the requests signed.";
        }
    }

    protected override void OnInitialized()
    {
        if (Webhook is null)
        {
            return;
        }

        url = Webhook.Url;
        var (groups, others) = WebhookEventChoices.Split(Webhook.Events);
        ticked.UnionWith(groups);
        kept = others;
    }

    private void Tick(
        string pattern,
        bool value)
    {
        if (value)
        {
            ticked.Add(pattern);
        }
        else
        {
            ticked.Remove(pattern);
        }
    }

    private void Submit()
    {
        if (!WebhookEventChoices.IsUsableAddress(url))
        {
            showErrors = true;
            return;
        }

        // Null keeps the secret the receiver has; an empty text removes it.
        var secretToSend = string.IsNullOrEmpty(secret) ? null : secret;
        if (removeSecret)
        {
            secretToSend = string.Empty;
        }

        MudDialog.Close(DialogResult.Ok(new WebhookDialogResult(
            url.Trim(),
            secretToSend,
            WebhookEventChoices.ToEvents(ticked, kept))));
    }

    private void Cancel() => MudDialog.Cancel();
}