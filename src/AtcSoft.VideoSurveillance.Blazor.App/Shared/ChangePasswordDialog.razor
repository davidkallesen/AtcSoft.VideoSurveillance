@* The signed-in user's own password. The server ends the user's sessions, so this browser signs in again with the new one. *@
@inject GatewayService Gateway
@inject AuthService Auth
@inject BrowserSession Session

<MudDialog>
    <DialogContent>
        <MudStack Spacing="3" Style="min-width: 320px;">
            <MudTextField @bind-Value="currentPassword"
                          Label="@Translations.CurrentPassword"
                          InputType="InputType.Password"
                          Variant="Variant.Outlined" />
            <MudTextField @bind-Value="newPassword"
                          Label="@Translations.NewPassword"
                          InputType="InputType.Password"
                          HelperText="@Translations.PasswordTooShort"
                          Variant="Variant.Outlined" />
            @if (problem is not null)
            {
                <MudAlert Severity="Severity.Error" Dense="true">@problem</MudAlert>
            }
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">@Translations.Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" Disabled="@busy" OnClick="SaveAsync">@Translations.Save</MudButton>
    </DialogActions>
</MudDialog>

@code {
    private string currentPassword = string.Empty;
    private string newPassword = string.Empty;
    private string? problem;
    private bool busy;

    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    private void Cancel()
        => MudDialog.Cancel();

    private async Task SaveAsync()
    {
        busy = true;
        problem = null;

        var changed = await Gateway.ChangeOwnPasswordAsync(currentPassword, newPassword);
        if (changed.IsSuccess)
        {
            problem = await Auth.SignInAsync(Session.UserName ?? string.Empty, newPassword);
        }
        else
        {
            problem = changed.Problem;
        }

        busy = false;
        if (problem is null)
        {
            MudDialog.Close(DialogResult.Ok(true));
        }
    }
}