@* Who is signed in, their own password, and signing out. *@
@inject AuthService Auth
@inject BrowserSession Session
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<MudMenu Icon="@Icons.Material.Filled.AccountCircle" Color="Color.Inherit" AriaLabel="@SignedInAs">
    <MudMenuItem Disabled="true">@SignedInAs</MudMenuItem>
    <MudDivider />
    <MudMenuItem Icon="@Icons.Material.Filled.Password" OnClick="ChangePasswordAsync">@Translations.ChangePassword</MudMenuItem>
    <MudMenuItem Icon="@Icons.Material.Filled.Logout" OnClick="SignOutAsync">@Translations.SignOut</MudMenuItem>
</MudMenu>

@code {
    // The menu's label names the user too (it was the bare format, "Signed in as {0}").
    private string SignedInAs
        => string.Format(CultureInfo.CurrentCulture, Translations.SignedInAs1, Session.UserName);

    private async Task ChangePasswordAsync()
    {
        var dialog = await DialogService.ShowAsync<ChangePasswordDialog>(Translations.ChangePassword);
        var result = await dialog.Result;
        if (result is { Canceled: false })
        {
            Snackbar.Add(Translations.PasswordChanged, Severity.Success);
        }
    }

    private Task SignOutAsync()
        => Auth.SignOutAsync();
}