<MudText Typo="Typo.subtitle1" Class="mb-1">Timelapse</MudText>
<SettingSwitch @bind-Value="State.EnableTimelapse"
               Label="Take timelapse snapshots"
               Help="A snapshot of every camera at a fixed interval, saved in the snapshot folder." />
<MudSelect @bind-Value="State.TimelapseInterval"
           Label="Interval"
           Disabled="!State.EnableTimelapse"
           Class="mt-2">
    @foreach (var (value, label) in SettingsOptions.WithCurrent(SettingsOptions.TimelapseIntervals, State.TimelapseInterval, v => v))
    {
        <MudSelectItem Value="@value">@label</MudSelectItem>
    }
</MudSelect>

@code {
    [Parameter, EditorRequired]
    public SettingsState State { get; set; } = null!;
}
