<MudText Typo="Typo.subtitle1" Class="mb-1">Camera overlay</MudText>
<SettingSwitch @bind-Value="State.ShowOverlayTitle" Label="Show title" />
<SettingSwitch @bind-Value="State.ShowOverlayDescription" Label="Show description" />
<SettingSwitch @bind-Value="State.ShowOverlayTime" Label="Show time" />
<SettingSwitch @bind-Value="State.ShowOverlayConnectionStatus" Label="Show connection status" />
<SettingSwitch @bind-Value="State.ShowOverlayQuickActions" Label="Show quick actions" />

<MudSelect @bind-Value="State.OverlayOpacity" Label="Overlay opacity" Class="mt-2">
    @foreach (var (value, label) in SettingsOptions.WithCurrent(SettingsOptions.OverlayOpacities, State.OverlayOpacity, v => v.ToString("P0", CultureInfo.InvariantCulture)))
    {
        <MudSelectItem Value="@value">@label</MudSelectItem>
    }
</MudSelect>

<MudSelect @bind-Value="State.OverlayPosition" Label="Overlay position" Class="mt-2">
    <MudSelectItem Value="AppSettingsOverlayPosition.TopLeft">Top left</MudSelectItem>
    <MudSelectItem Value="AppSettingsOverlayPosition.TopRight">Top right</MudSelectItem>
    <MudSelectItem Value="AppSettingsOverlayPosition.BottomLeft">Bottom left</MudSelectItem>
    <MudSelectItem Value="AppSettingsOverlayPosition.BottomRight">Bottom right</MudSelectItem>
</MudSelect>

<SettingSwitch @bind-Value="State.ShowOverlayConnectionTypeIcon"
               Label="Show connection-type icon"
               Help="A LAN, Wi-Fi or USB icon in a free corner of the camera tile."
               Class="mt-2" />
<MudSelect @bind-Value="State.ConnectionTypeIconPlacement" Label="Connection-type icon position" Disabled="!State.ShowOverlayConnectionTypeIcon" Class="mt-2">
    <MudSelectItem Value="AppSettingsConnectionTypeIconPlacement.SameRow">@State.GetConnectionTypeIconPlacementLabel(AppSettingsConnectionTypeIconPlacement.SameRow)</MudSelectItem>
    <MudSelectItem Value="AppSettingsConnectionTypeIconPlacement.SameColumn">@State.GetConnectionTypeIconPlacementLabel(AppSettingsConnectionTypeIconPlacement.SameColumn)</MudSelectItem>
</MudSelect>

<MudDivider Class="my-4" />

<MudText Typo="Typo.subtitle1" Class="mb-1">Grid layout</MudText>
<SettingSwitch @bind-Value="State.AllowDragAndDropReorder" Label="Allow drag and drop reorder" />
<SettingSwitch @bind-Value="State.AutoSaveLayoutChanges" Label="Save layout changes automatically" />

<MudDivider Class="my-4" />

<MudText Typo="Typo.subtitle1" Class="mb-1">Snapshots</MudText>
<MudTextField @bind-Value="State.SnapshotPath"
              Label="Snapshot folder"
              HelperText="A folder on the server."
              Class="mt-2" />

@code {
    [Parameter, EditorRequired]
    public SettingsState State { get; set; } = null!;
}
