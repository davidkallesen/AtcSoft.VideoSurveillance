<MudText Typo="Typo.subtitle1" Class="mb-1">Video</MudText>
<MudSelect @bind-Value="State.VideoQuality"
           Label="Video quality"
           HelperText="The highest resolution the desktop apps decode at."
           Class="mt-2">
    @foreach (var (value, label) in SettingsOptions.WithCurrent(SettingsOptions.VideoQualities, State.VideoQuality, v => v))
    {
        <MudSelectItem Value="@value">@label</MudSelectItem>
    }
</MudSelect>
<SettingSwitch @bind-Value="State.HardwareAcceleration" Label="Hardware acceleration" Class="mt-2" />

<MudDivider Class="my-4" />

<MudText Typo="Typo.subtitle1" Class="mb-1">Streaming</MudText>
<SettingSwitch @bind-Value="State.LowLatencyMode" Label="Low latency mode" />
<MudNumericField @bind-Value="State.MaxLatencyMs" Label="Max latency (ms)" Min="100" Max="10000" Step="50" Class="mt-2" />
<MudNumericField @bind-Value="State.BufferDurationMs" Label="Buffer duration (ms)" Min="100" Max="5000" Step="50" Class="mt-2" />
<MudSelect @bind-Value="State.RtspTransport" Label="RTSP transport" Class="mt-2">
    <MudSelectItem Value="AppSettingsRtspTransport.Tcp">TCP</MudSelectItem>
    <MudSelectItem Value="AppSettingsRtspTransport.Udp">UDP</MudSelectItem>
</MudSelect>

@code {
    [Parameter, EditorRequired]
    public SettingsState State { get; set; } = null!;
}
