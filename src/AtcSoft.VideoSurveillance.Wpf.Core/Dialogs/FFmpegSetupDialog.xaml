<atc:NiceWindow
    x:Class="AtcSoft.VideoSurveillance.Wpf.Core.Dialogs.FFmpegSetupDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:atc="https://github.com/atc-net/atc-wpf/tree/main/schemas"
    xmlns:atcTranslation="https://github.com/atc-net/atc-wpf/tree/main/schemas/translations"
    xmlns:atcValueConverters="https://github.com/atc-net/atc-wpf/tree/main/schemas/value-converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:dialogs="clr-namespace:AtcSoft.VideoSurveillance.Wpf.Core.Dialogs"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="{atcTranslation:Resx ResxName=AtcSoft.VideoSurveillance.Resources.Translations,
                                Key=FFmpegSetup}"
    Width="620"
    d:DataContext="{d:DesignInstance Type=dialogs:FFmpegSetupDialogViewModel,
                                     IsDesignTimeCreatable=False}"
    ResizeMode="NoResize"
    SizeToContent="Height"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">

    <atc:GridEx Margin="20" Rows="Auto,Auto,Auto,Auto,Auto,Auto">

        <!--  What is needed  -->
        <TextBlock
            Grid.Row="0"
            FontSize="14"
            FontWeight="SemiBold"
            Text="{Binding Path=Message}"
            TextWrapping="Wrap" />

        <!--  What was found  -->
        <StackPanel
            Grid.Row="1"
            Margin="0,12,0,0"
            Visibility="{Binding Path=HasFoundFolders, Converter={x:Static atcValueConverters:BoolToVisibilityVisibleValueConverter.Instance}}">
            <TextBlock Text="{atcTranslation:Resx ResxName=AtcSoft.VideoSurveillance.Resources.Translations, Key=FFmpegFoundOnThisComputer}" />
            <ItemsControl Margin="12,4,0,0" ItemsSource="{Binding Path=FoundFolders}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" TextWrapping="Wrap" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>

        <!--  The install  -->
        <Border
            Grid.Row="2"
            Margin="0,16,0,0"
            Padding="12"
            Background="{DynamicResource MahApps.Brushes.Gray10}"
            CornerRadius="4">
            <StackPanel>
                <TextBlock Text="{Binding Path=InstallHint}" TextWrapping="Wrap" />
                <ProgressBar
                    Height="6"
                    Margin="0,12,0,0"
                    Maximum="100"
                    Visibility="{Binding Path=IsInstalling, Converter={x:Static atcValueConverters:BoolToVisibilityVisibleValueConverter.Instance}}"
                    Value="{Binding Path=InstallProgress}" />
                <TextBlock
                    Margin="0,8,0,0"
                    Text="{Binding Path=StatusText}"
                    TextWrapping="Wrap">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Path=HasError}" Value="True">
                                    <Setter Property="Foreground" Value="OrangeRed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
        </Border>

        <!--  Or a folder  -->
        <atc:LabelDirectoryPicker
            Grid.Row="3"
            Margin="0,16,0,0"
            LabelText="{Binding Path=ChooseFolderText}"
            Orientation="Vertical"
            WatermarkText="{atcTranslation:Resx ResxName=AtcSoft.VideoSurveillance.Resources.Translations,
                                                Key=FFmpegFolder}"
            Value="{Binding Path=FolderDirectory, Mode=TwoWay}" />

        <!--  Buttons  -->
        <atc:GridEx
            Grid.Row="5"
            Margin="0,8,0,0"
            Columns="Auto,*,Auto">
            <Button
                Grid.Column="0"
                Padding="12,6"
                Command="{Binding Path=OpenDownloadPageCommand}"
                Content="{atcTranslation:Resx ResxName=AtcSoft.VideoSurveillance.Resources.Translations,
                                              Key=FFmpegDownloadPage}" />
            <StackPanel
                Grid.Column="2"
                HorizontalAlignment="Right"
                Orientation="Horizontal">
                <Button
                    MinWidth="120"
                    Margin="0,0,8,0"
                    Padding="16,8"
                    Command="{Binding Path=InstallCommand}"
                    Content="{atcTranslation:Resx ResxName=AtcSoft.VideoSurveillance.Resources.Translations,
                                                  Key=FFmpegInstall}"
                    IsDefault="True" />
                <Button
                    MinWidth="80"
                    Margin="0,0,8,0"
                    Padding="16,8"
                    Command="{Binding Path=CancelInstallCommand}"
                    Content="{atcTranslation:Resx ResxName=AtcSoft.VideoSurveillance.Resources.Translations,
                                                  Key=Cancel}"
                    Visibility="{Binding Path=IsInstalling, Converter={x:Static atcValueConverters:BoolToVisibilityVisibleValueConverter.Instance}}" />
                <Button
                    MinWidth="120"
                    Margin="0,0,8,0"
                    Padding="16,8"
                    Command="{Binding Path=UseFolderCommand}"
                    Content="{atcTranslation:Resx ResxName=AtcSoft.VideoSurveillance.Resources.Translations,
                                                  Key=FFmpegUseFolder}" />
                <Button
                    MinWidth="80"
                    Padding="16,8"
                    Command="{Binding Path=ExitCommand}"
                    Content="{atcTranslation:Resx ResxName=AtcSoft.VideoSurveillance.Resources.Translations,
                                                  Key=Exit}"
                    IsCancel="True" />
            </StackPanel>
        </atc:GridEx>
    </atc:GridEx>
</atc:NiceWindow>