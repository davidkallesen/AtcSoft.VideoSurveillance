<UserControl
    x:Class="AtcSoft.VideoSurveillance.Wpf.Core.Dialogs.Parts.Settings.RecordingsBrowserSettings"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:atc="https://github.com/atc-net/atc-wpf/tree/main/schemas"
    xmlns:atcTranslation="https://github.com/atc-net/atc-wpf/tree/main/schemas/translations"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:dialogs="clr-namespace:AtcSoft.VideoSurveillance.Wpf.Core.Dialogs"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DataContext="{d:DesignInstance Type=dialogs:SettingsDialogViewModel,
                                     IsDesignTimeCreatable=False}"
    d:DesignWidth="600"
    mc:Ignorable="d">

    <GroupBox Header="{atcTranslation:Resx ResxName=AtcSoft.VideoSurveillance.Resources.Translations, Key=RecordingsBrowserSettings}">
        <StackPanel Margin="0,5,0,-20" Orientation="Vertical">

            <atc:LabelToggleSwitch
                InformationText="{atcTranslation:Resx ResxName=AtcSoft.VideoSurveillance.Resources.Translations,
                                                      Key=CloseRecordingsBrowserOnPlayHint}"
                IsOn="{Binding Path=CloseRecordingsBrowserOnPlay, Mode=TwoWay}"
                LabelPosition="Right"
                LabelText="{atcTranslation:Resx ResxName=AtcSoft.VideoSurveillance.Resources.Translations,
                                                Key=CloseRecordingsBrowserOnPlay}" />

            <atc:LabelToggleSwitch
                InformationText="{atcTranslation:Resx ResxName=AtcSoft.VideoSurveillance.Resources.Translations,
                                                      Key=RememberRecordingsBrowserStateHint}"
                IsOn="{Binding Path=RememberRecordingsBrowserState, Mode=TwoWay}"
                LabelPosition="Right"
                LabelText="{atcTranslation:Resx ResxName=AtcSoft.VideoSurveillance.Resources.Translations,
                                                Key=RememberRecordingsBrowserState}" />

        </StackPanel>
    </GroupBox>
</UserControl>