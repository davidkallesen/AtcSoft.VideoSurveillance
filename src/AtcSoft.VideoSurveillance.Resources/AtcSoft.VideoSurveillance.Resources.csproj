<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>true</IsPackable>
    <Description>The texts of the AtcSoft VideoSurveillance and CameraWall applications in US and British English, Danish and German.</Description>
    <PackageTags>surveillance;camera;translations;localization</PackageTags>
  </PropertyGroup>

  <PropertyGroup Label="NuGet Package Metadata">
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>

    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/davidkallesen/AtcSoft.VideoSurveillance</PackageProjectUrl>
    <RepositoryUrl>https://github.com/davidkallesen/AtcSoft.VideoSurveillance.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\images\icon.png" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

  <!-- The Translations class is generated by the build, so a new key is usable from any editor -->
  <ItemGroup>
    <EmbeddedResource Update="Translations.resx">
      <StronglyTypedLanguage>CSharp</StronglyTypedLanguage>
      <StronglyTypedNamespace>AtcSoft.VideoSurveillance.Resources</StronglyTypedNamespace>
      <StronglyTypedClassName>Translations</StronglyTypedClassName>
      <StronglyTypedFileName>$(IntermediateOutputPath)Translations.Designer.cs</StronglyTypedFileName>
      <PublicClass>true</PublicClass>
    </EmbeddedResource>
    <EmbeddedResource Update="Translations.*.resx">
      <DependentUpon>Translations.resx</DependentUpon>
    </EmbeddedResource>
  </ItemGroup>

</Project>