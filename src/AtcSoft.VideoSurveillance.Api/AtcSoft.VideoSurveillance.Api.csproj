<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <!-- net10.0-windows so the host can reference AtcSoft.VideoEngine.Windows
         (Media Foundation USB enumerator + WMI hot-plug watcher). The
         server is Windows-bound today — FFmpeg native libs ship via
         Flyleaf.FFmpeg.Bindings, the recording paths use Windows
         conventions, and Linux/V4L2 is a deferred roadmap phase. -->
    <TargetFramework>net10.0-windows</TargetFramework>
    <NoWarn>$(NoWarn);SA1649;MA0048;CA1416</NoWarn>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Atc.Hosting" Version="2.0.2" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.8" />
    <!-- Pinned above the 2.0.0 that Microsoft.AspNetCore.OpenApi 10.0.8 pulls in transitively (NU1903 / GHSA-v5pm-xwqc-g5wc). -->
    <PackageReference Include="Microsoft.OpenApi" Version="2.12.2" />
    <PackageReference Include="Scalar.AspNetCore" Version="2.14.11" />
    <PackageReference Include="Serilog.AspNetCore" Version="10.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AtcSoft.VideoSurveillance.Api.Contracts\AtcSoft.VideoSurveillance.Api.Contracts.csproj" />
    <ProjectReference Include="..\AtcSoft.VideoSurveillance.Api.Domain\AtcSoft.VideoSurveillance.Api.Domain.csproj" />
    <ProjectReference Include="..\AtcSoft.VideoSurveillance.Core\AtcSoft.VideoSurveillance.Core.csproj" />
    <ProjectReference Include="..\AtcSoft.VideoEngine\AtcSoft.VideoEngine.csproj" />
    <ProjectReference Include="..\AtcSoft.VideoEngine.Windows\AtcSoft.VideoEngine.Windows.csproj" />
  </ItemGroup>

</Project>