<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="https://api.nuget.org/v3/index.json" value="https://api.nuget.org/v3/index.json" />
    <!-- TEMPORARY until Atc.Rest.Api.SourceGenerator 3.0 is on nuget.org: a locally packed v3 (plans/roadmap-rest-api-sg.md, phase 0). CI cannot restore while this is in. -->
    <add key="local-atc-rest-api-sg" value="D:/Code/local-feed" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="https://api.nuget.org/v3/index.json">
      <package pattern="*" />
    </packageSource>
    <packageSource key="local-atc-rest-api-sg">
      <package pattern="Atc.Rest.Api.SourceGenerator" />
    </packageSource>
  </packageSourceMapping>
</configuration>